  "interactions": [
    {
      "id": "interaction.survivor",
      "kind": "npc",
      "prompt": "Speak with the survivor",
      "use_radius_meters": 1.5,
      "effect": "begin_survivor_dialogue",
      "dialogue": {
        "speaker": "Survivor",
        "line": "One reserve cell, two systems. Corridor power gives you steady lights; shelter power keeps the seals stable. The security frame beyond the door is still active. Watch its wind-up and interrupt the strike.",
        "responses": [
          {
            "id": "response.reroute_service_power",
            "text": "Reroute power to the service corridor. We need a clear route.",
            "effect": "reroute_service_power"
          },
          {
            "id": "response.preserve_shelter_power",
            "text": "Keep the shelter sealed. We will take the corridor as it is.",
            "effect": "preserve_shelter_power"
          }
        ]
      }
    },
    {
      "id": "interaction.service_door.entry",
      "kind": "environment",
      "prompt": "Open the entry service door",
      "use_radius_meters": 1.25,
      "effect": "open_entry_service_door",
      "result_text": "The entry service door unlocks and slides open."
    },
    {
      "id": "interaction.service_door.solo_exit",
