      "prompt": "Open the arena exit service door",
      "use_radius_meters": 1.25,
      "effect": "open_solo_exit_service_door",
      "result_text": "The arena exit unlocks after the security threat is cleared."
    },
    {
      "id": "interaction.protector",
      "kind": "npc",
      "prompt": "Recruit the Protector",
      "use_radius_meters": 1.5,
      "effect": "begin_recruitment_dialogue",
      "dialogue": {
        "speaker": "Protector",
        "line": "The transit hall has a close-range Enforcer and a sentry. I'll block the sentry's shots with my Barrier and draw their attention. You interrupt the Enforcer. We move together.",
        "responses": [
          {
            "id": "response.recruit_protector",
            "text": "Join me. We leave together.",
            "effect": "recruit_protector"
          }
        ]
      }
    },
    {
      "id": "interaction.service_terminal",
      "kind": "environment",
      "prompt": "Inspect the service terminal",
      "use_radius_meters": 1.25,
      "effect": "record_observation",
      "result_text": "The terminal confirms full service-corridor power. Shelter seals are running on emergency reserve.",
      "preserved_result_text": "The terminal confirms stable shelter seals. The service corridor remains on intermittent emergency lighting."
    },
    {
      "id": "interaction.medic",
      "kind": "npc",
      "prompt": "Recruit the Medic",
      "use_radius_meters": 1.5,
      "effect": "begin_medic_recruitment_dialogue",
      "dialogue": {
        "speaker": "Medic",
        "line": "Four security positions block the cutter. I can heal one of us quickly or place a healing field. Stay inside it while we hold the line. After each fight we regroup and recover.",
        "responses": [
          {
            "id": "response.recruit_medic",
            "text": "Join the crew. We will reach the cutter together.",
            "effect": "recruit_medic"
          }
        ]
      }
    },
